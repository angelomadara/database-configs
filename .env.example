# Copy to .env and fill in. .env is gitignored; never commit it.
#
# VALKEY_PASSWORD is REQUIRED and must be non-empty: the valkey service refuses
# to start without it rather than running with no authentication.
#
# QUOTING: if a value contains $, #, a quote or a space, wrap it in SINGLE
# quotes. Compose's .env parser expands $VAR in unquoted values, so an unquoted
# password like  p@ss$word#1  silently becomes  p@ss#1  -- and because the
# healthcheck reads the same substituted value, the container still reports
# "healthy" while the runtime password no longer matches what you wrote here.
#   VALKEY_PASSWORD='p@ss$word#1'
# Single quotes are literal: verified to round-trip exactly.
# Alphanumeric passwords need no quoting.
#
# Generate one with:  openssl rand -base64 24 | tr -d '/+=' 
# (note: avoid / + = -- base64 output needs quoting otherwise)

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

VALKEY_PASSWORD=

# Host port valkey is published on. Defaults to 16379 when unset, so leaving
# this line out is safe. Only set it if you are deliberately moving the port:
# both remote clients (the BullMQ worker and RedisInsight) dial 16379, and the
# OCI ingress rule and any SSH tunnel would need updating to match.
VALKEY_PORT=16379
